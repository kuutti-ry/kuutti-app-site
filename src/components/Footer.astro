---
import type { Locale } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";
import { MARKS } from "../lib/marks.ts";
import { SITE } from "../site.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// One line, and the association's channels beside it by their marks
// (docs/decisions.md, 8; the marks are src/lib/marks.ts).
---

<footer class="site-footer">
  <div>
    <p>{t(locale, "footer.line", { businessId: SITE.businessId })}</p>
    {
      SITE.social.length > 0 && (
        <ul class="channels" aria-label={t(locale, "footer.channels")}>
          {SITE.social.map((channel) => (
            <li>
              <a href={channel.href} aria-label={t(locale, "footer.channel", { name: channel.name })}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                  <path d={MARKS[channel.mark]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

---
import type { Locale } from "../i18n/locales.ts";
import { t } from "../i18n/ui.ts";
import { MARKS } from "../lib/marks.ts";
import { SITE } from "../site.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// The association as the register has it, its address in both the forms it is
// written in, the address to write to, and its channels beside them by their
// marks (docs/decisions.md, 8, 15 and 19; the marks are src/lib/marks.ts).
---

<footer class="site-footer">
  <div>
    <address>
      <p>{t(locale, "footer.address", { address: SITE.postalAddress })}</p>
      <p>{t(locale, "footer.address", { address: SITE.postalAddressJoined })}</p>
      <p>{t(locale, "footer.businessId", { businessId: SITE.businessId })}</p>
      {
        SITE.contactEmail !== null && (
          <p>
            <a class="mail-us" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
          </p>
        )
      }
    </address>
    {
      SITE.social.length > 0 && (
        <ul class="channels" aria-label={t(locale, "footer.channels")}>
          {SITE.social.map((channel) => (
            <li>
              <a href={channel.href} aria-label={t(locale, "footer.channel", { name: channel.name })}>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                  <path d={MARKS[channel.mark]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

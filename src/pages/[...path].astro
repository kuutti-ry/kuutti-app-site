---
import Notice from "../components/Notice.astro";
import StoreBadges from "../components/StoreBadges.astro";
import { formatDate, LANGUAGE_IN, STATUS_KEY, t } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { anchorOf, isConsentKind } from "../lib/consent.ts";
import { consentsOn, legalShelf, writtenIn } from "../lib/content.ts";
import { drawFlags } from "../lib/flag.ts";
import { type RouteProps, routes } from "../lib/routes.ts";
import { SITE } from "../site.ts";

// Every page of the site is made here; src/lib/routes.ts says which there are.
type Props = RouteProps;

export const getStaticPaths = routes;

const { locale, slug, alternates, view } = Astro.props;

const shelf = await legalShelf(locale);

// A text as the content layer rendered it, with the flag of Finland drawn
// where the author wrote its emoji (src/lib/flag.ts). Nothing else runs on it.
const htmlOf = (entry: { id: string; rendered?: { html: string } }): string => {
  if (entry.rendered === undefined) throw new Error(`${entry.id} was not rendered`);
  return drawFlags(entry.rendered.html);
};
const html =
  view.kind === "page" ? htmlOf(view.page) : view.kind === "text" ? htmlOf(view.text) : null;

// The home page says what the placeholder page said (docs/decisions.md, 8):
// the logo, the name, and that the app is coming. Nothing else, no button.
const head =
  view.kind === "home"
    ? { title: t(locale, "site.name"), description: t(locale, "home.description") }
    : view.kind === "shelf"
      ? { title: t(locale, "legal.title"), description: t(locale, "legal.description") }
      : view.kind === "page"
        ? { title: view.page.data.title, description: view.page.data.description }
        : { title: view.text.data.title, description: view.text.data.description };
const draft = view.kind === "text" && view.text.data.status === "draft";
const filed = view.kind === "text" && view.text.data.status === "filed";
// A legal text is read in the language it was written in, whatever the site speaks.
const textLanguage = view.kind === "text" ? writtenIn(view.text.id).language : locale;
// A text a person agrees to in the app names its version where the app's link
// lands (#<kind>-<version>), and the privacy page carries the consents the app
// asks apart, in their own words and languages (kuutti-ry/kuutti-app#208).
const textSlug = view.kind === "text" ? writtenIn(view.text.id).slug : "";
const consentVersion = view.kind === "text" ? view.text.data.consent_version : undefined;
const versionAnchor =
  isConsentKind(textSlug) && consentVersion ? anchorOf(textSlug, consentVersion) : undefined;
const consents = view.kind === "text" ? await consentsOn(locale, textSlug) : [];
// A draft's version is the one the app records for the draft; the text in
// force will be given its own (the drafts say so), so the line says which.
const versionKey = draft ? "doc.draftVersion" : "doc.version";
---

<Base
  locale={locale}
  slug={slug}
  title={head.title}
  description={head.description}
  alternates={alternates}
  noindex={draft}
>
  {
    view.kind === "home" && (
      <section class="hero">
        <img src="/logo.png" alt="" width="840" height="572" />
        <h1>{t(locale, "site.name")}</h1>
        <StoreBadges locale={locale} />
      </section>
    )
  }

  {
    view.kind === "page" && html !== null && (
      <article class="prose">
        <h1>{view.page.data.title}</h1>
        {view.page.data.machine && (
          <Notice
            title={t(locale, "notice.machine.title")}
            body={t(locale, "notice.machine.body")}
          />
        )}
        <Fragment set:html={html} />
      </article>
    )
  }

  {
    view.kind === "shelf" && (
      <section class="prose">
        <h1>{t(locale, "legal.title")}</h1>
        <p class="lead">{t(locale, "legal.intro")}</p>
        <ul class="documents">
          {shelf.map((text) => (
            <li id={text.slug}>
              <h2>
                {text.title}
                <span class="tag">
                  {t(locale, STATUS_KEY[text.status])}
                </span>
              </h2>
              <p>{text.description}</p>
              <ul class="versions">
                {text.versions.map((version) => (
                  <li>
                    <a
                      href={version.href}
                      hreflang={version.language}
                      aria-label={`${text.title}, ${LANGUAGE_IN[locale][version.language]}`}
                    >
                      {LANGUAGE_IN[locale][version.language]}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    view.kind === "text" && html !== null && (
      <article class="prose" lang={textLanguage === locale ? undefined : textLanguage}>
        <h1>{view.text.data.title}</h1>
        <p class="meta" id={versionAnchor}>
          {t(locale, "doc.dated", { date: formatDate(locale, view.text.data.dated) })}
          {consentVersion && ` · ${t(locale, versionKey, { version: consentVersion })}`}
          {view.text.data.registered &&
            ` · ${t(locale, "doc.registered", { date: formatDate(locale, view.text.data.registered) })}`}
          {view.text.data.businessId &&
            ` · ${t(locale, "doc.businessId", { businessId: SITE.businessId })}`}
        </p>
        {draft && (
          <Notice title={t(locale, "notice.draft.title")} body={t(locale, "notice.draft.body")} />
        )}
        {filed && (
          <Notice title={t(locale, "notice.filed.title")} body={t(locale, "notice.filed.body")} />
        )}
        {view.binding && (
          <Notice
            title={t(locale, "notice.notBinding.title")}
            body={t(locale, "notice.notBinding.body")}
          />
        )}
        <Fragment set:html={html} />
        {consents.length > 0 && (
          <>
            <h2>{t(locale, "consents.title")}</h2>
            <p>{t(locale, "consents.intro")}</p>
            {consents.map((consent) => (
              <>
                <h3 id={anchorOf(consent.kind, consent.version)}>{consent.title}</h3>
                <p class="meta">
                  {t(locale, "doc.dated", { date: formatDate(locale, consent.dated) })}
                  {` · ${t(locale, versionKey, { version: consent.version })}`}
                </p>
                {consent.wordings.map((wording) => (
                  <>
                    <p>
                      {t(locale, wording.language === "fi" ? "consents.counts" : "consents.wording", {
                        language: LANGUAGE_IN[locale][wording.language],
                      })}
                    </p>
                    <blockquote lang={wording.language === textLanguage ? undefined : wording.language}>
                      <p>
                        <strong>{wording.title}</strong>
                      </p>
                      <Fragment set:html={wording.html} />
                    </blockquote>
                  </>
                ))}
              </>
            ))}
          </>
        )}
      </article>
    )
  }
</Base>
